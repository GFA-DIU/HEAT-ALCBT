              class="btn btn-sm btn-outline text-[var(--text--sub-600)] border-[var(--stroke--soft-200)] w-fit"
              onclick="structural_component_epd_modal.close()"
            >
              Cancel
            </button>
            <button type="submit" class="btn btn-sm btn-primary w-fit">
              Save
            </button>
          </div>
        </div>
      </div>
    </dialog>

    <script>
      // View template details
      function viewTemplate(assemblyId) {
        // Show loading state
        document.getElementById('modal-template-name').textContent = 'Loading...';
        document.getElementById('modal-template-title').textContent = '';
        document.getElementById('modal-materials-list').innerHTML = '<li class="text-center py-4">Loading...</li>';

        // Open the modal
        template_detail_modal.showModal();

        // Fetch template details
        fetch(`/templates/${assemblyId}/`)
          .then(response => {
            if (!response.ok) {
              throw new Error('Failed to load template');
            }
            return response.json();
          })
          .then(data => {
            // Update modal header
            document.getElementById('modal-template-name').textContent = data.name;
            document.getElementById('modal-template-title').textContent = data.name;

            // Update country
            const countryEl = document.getElementById('modal-template-country');
            if (data.country_code && data.country_name) {
              countryEl.innerHTML = `
                <span data-country="${data.country_code}" data-width="20"></span>
                <span>${data.country_name}</span>
              `;
            } else {
              countryEl.textContent = 'N/A';
            }

            // Update dimension
            document.getElementById('modal-template-dimension').textContent = data.dimension_display || 'N/A';

            // Update mode
            document.getElementById('modal-template-mode').textContent = data.mode_display || 'N/A';

            // Update classification
            const classEl = document.getElementById('modal-template-classification');
            if (data.classification) {
              classEl.textContent = data.classification.category +
                (data.classification.technique ? ` - ${data.classification.technique}` : '');
            } else {
              classEl.textContent = 'N/A';
            }

            // Update GWP
            document.getElementById('modal-template-gwp').textContent =
              `${data.total_gwp} kg CO2e eq/${data.dimension_display}`;

            // Update comment
            const commentFieldset = document.getElementById('modal-template-comment-fieldset');
            const commentEl = document.getElementById('modal-template-comment');
            if (data.comment) {
              commentFieldset.style.display = 'block';
              commentEl.textContent = data.comment;
            } else {
              commentFieldset.style.display = 'none';
            }

            // Update materials count
            document.getElementById('modal-materials-count').textContent = data.materials.length;

            // Update materials list
            const materialsList = document.getElementById('modal-materials-list');
            if (data.materials.length === 0) {
              materialsList.innerHTML = '<li class="text-center py-4 text-[var(--text--sub-600)]">No materials added</li>';
            } else {
              materialsList.innerHTML = data.materials.map(material => `
                <li class="bg-[var(--bg--weak-50)] rounded-xl p-4">
                  <div class="flex items-center justify-between mb-2 w-full">
                    <span class="text-sm/5 font-medium">${material.name}</span>
                    ${material.epd_link ? `
                      <a href="${material.epd_link}" target="_blank" title="View EPD details">
                        <span
                          data-icon="external-link-line"
                          data-size="20"
                          data-color="var(--icon--sub-600)"
                        ></span>
                      </a>
                    ` : ''}
                  </div>
                  <div class="flex items-stretch gap-1 bg-[var(--bg--white-0)] rounded-xl p-2.5">
                    ${material.country_code ? `
                      <div class="bg-[var(--bg--weak-50)] px-1 flex items-center shrink-0 rounded-[var(--radius-6)]">
                        <span data-country="${material.country_code}" data-width="20"></span>
                      </div>
                    ` : ''}
                    <div class="flex-[2.5] text-sm/5 p-2">
                      ${material.description || 'No description'}
                    </div>
                    <div class="flex-1 text-sm/5 p-2 text-right font-medium">
                      ${material.quantity} ${material.unit}
                    </div>
                    <div class="flex-1 text-sm/5 p-2 text-right font-semibold text-green-600">
                      ${material.gwp} kg CO2e
                    </div>
                  </div>
                </li>
              `).join('');
            }

            // Reinitialize icons and country flags after updating content
            if (typeof initializeIcons === 'function') {
              initializeIcons();
            }
            if (typeof initializeCountryFlags === 'function') {
              initializeCountryFlags();
            }
          })
          .catch(error => {
            console.error('Error loading template:', error);
            document.getElementById('modal-template-name').textContent = 'Error';
            document.getElementById('modal-materials-list').innerHTML =
              '<li class="text-center py-4 text-red-600">Failed to load template details</li>';
          });
      }

      // Duplicate template
      function duplicateTemplate(assemblyId) {
        if (!confirm('Do you want to create a copy of this template?')) {
          return;
        }

        // TODO: Implement backend endpoint for duplication
        fetch(`/api/templates/${assemblyId}/duplicate/`, {
          method: 'POST',
          headers: {
            'X-CSRFToken': getCsrfToken(),
            'Content-Type': 'application/json'
          }
        })
        .then(response => {
          if (response.ok) {
            // Reload the list
            htmx.trigger('#search-form', 'submit');
            Toast.success('Template duplicated successfully!');
          } else {
            alert('Failed to duplicate template');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('An error occurred while duplicating the template');
        });
      }

      // Delete template
      function deleteTemplate(assemblyId, assemblyName) {
        if (!confirm(`Are you sure you want to delete "${assemblyName}"? This action cannot be undone.`)) {
          return;
        }

        // TODO: Implement backend endpoint for deletion
        fetch(`/api/templates/${assemblyId}/delete/`, {
          method: 'DELETE',
          headers: {
            'X-CSRFToken': getCsrfToken(),
            'Content-Type': 'application/json'
          }
        })
        .then(response => {
          if (response.ok) {
            // Reload the list
            htmx.trigger('#search-form', 'submit');
            Toast.success('Template deleted successfully!');
          } else {
            alert('Failed to delete template');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          Toast.error('An error occurred while deleting the template');
        });
      }

      // Helper function to get CSRF token
      function getCsrfToken() {
        return document.querySelector('[name=csrfmiddlewaretoken]')?.value ||
               document.cookie.split('; ')
                 .find(row => row.startsWith('csrftoken='))
                 ?.split('=')[1];
      }
    </script>

{% endblock %}