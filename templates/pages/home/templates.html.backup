{% extends "_base.html" %}
{% load static %}

{% block title %}Home - HEAT Building LCA{% endblock %}

{% block body_class %}min-h-screen bg-[var(--bg--base-500)] flex flex-col{% endblock body_class %}

{% block content %}
 
    <section class="flex-1 card bg-white rounded-none rounded-t-[var(--radius-24)] border border-[var(--stroke--soft-200)] pb-6">
      <div class="max-w-[68.75rem] mx-auto w-full px-4">
        <div class="flex flex-col gap-6 w-full mt-7">
          <div
            class="flex flex-col text-2xl/[110%] font-extrabold text-[var(--text--strong-950)]"
          >
            Reusable Templates
            <p class="text-sm font-normal text-[var(--text--sub-600)]">
              Add your buildings to access for low carbon
            </p>
          </div>
        </div>
        <form
          id="search-form"
          hx-get="{% url 'templates' %}"
          hx-target="#templates-list"
          hx-swap="outerHTML"
          hx-trigger="submit, change from:select delay:300ms, keyup changed delay:500ms from:input[name='search_query']"
          class="p-2.5 flex flex-col w-full rounded-[var(--radius-10)] bg-[var(--bg--weak-50)] mt-5"
        >
          <div class="flex items-stretch gap-2">
            <label class="input w-full">
              <span
                data-icon="search-2-line"
                data-size="16"
                data-color="var(--icon--soft-400)"
              ></span>
              <input type="text" name="search_query" placeholder="Search templates..." value="{{ search_query }}" />
            </label>
            <select class="select" name="country">
              <option value="">All Countries</option>
              {% for country in countries %}
                <option value="{{ country.id }}" {% if selected_country == country.id|stringformat:"s" %}selected{% endif %}>
                  {{ country.name }}
                </option>
              {% endfor %}
            </select>
          </div>
          <div class="collapse rounded-none">
            <input type="checkbox" class="peer" />
            <div
              class="group collapse-title p-2.5 px-0 bg-[var(--bg--weak-50)] text-[0.813rem]/5 font-semibold flex items-center justify-between rounded-[var(--radius-4)]"
            >
              <span class="flex items-center gap-2">
                <span
                  data-icon="menu-search-line"
                  data-size="20"
                  data-color="var(--icon--strong-950)"
                ></span>
                Advanced Search
                <span class="text-xs/5 text-[var(--text--sub-600)]"
                  >Click here for a more advanced search option</span
                >
              </span>
              <span
                data-icon="caret-down"
                data-size="16"
                data-color="var(--icon--soft-400)"
                class="transition-transform duration-300 ease-in-out group-[peer:checked]:rotate-180"
              ></span>
            </div>
            <div class="collapse-content mt-0 px-0">
              <div class="grid grid-cols-4 gap-2">
                <label class="relative">
                  <span
                    data-icon="filter-3-line"
                    data-size="20"
                    data-color="var(--icon--soft-400)"
                    class="select-icon w-8"
                  ></span>
                  <select
                    name="category"
                    class="select py-0 pl-8 h-9 text-sm/5 text-[var(--text--sub-600)] rounded-[var(--radius-8)]"
                  >
                    <option value="">Building Component</option>
                    {% for category in categories %}
                      <option value="{{ category.id }}" {% if selected_category == category.id|stringformat:"s" %}selected{% endif %}>
                        {{ category.name }}
                      </option>
                    {% endfor %}
                  </select>
                </label>
                <label class="relative">
                  <span
                    data-icon="filter-3-line"
                    data-size="20"
                    data-color="var(--icon--soft-400)"
                    class="select-icon w-8"
                  ></span>
                  <select
                    name="technique"
                    class="select py-0 pl-8 h-9 text-sm/5 text-[var(--text--sub-600)] rounded-[var(--radius-8)]"
                  >
                    <option value="">Construction Technique</option>
                    {% for technique in techniques %}
                      <option value="{{ technique.id }}" {% if selected_technique == technique.id|stringformat:"s" %}selected{% endif %}>
                        {{ technique.name }}
                      </option>
                    {% endfor %}
                  </select>
                </label>
                <label class="relative">
                  <span
                    data-icon="filter-3-line"
                    data-size="20"
                    data-color="var(--icon--soft-400)"
                    class="select-icon w-8"
                  ></span>
                  <select
                    name="mode"
                    class="select py-0 pl-8 h-9 text-sm/5 text-[var(--text--sub-600)] rounded-[var(--radius-8)]"
                  >
                    <option value="">All Types</option>
                    <option value="system" {% if selected_mode == 'system' %}selected{% endif %}>System Component</option>
                    <option value="custom" {% if selected_mode == 'custom' %}selected{% endif %}>My Component</option>
                  </select>
                </label>
                <label class="relative">
                  <span
                    data-icon="filter-3-line"
                    data-size="20"
                    data-color="var(--icon--soft-400)"
                    class="select-icon w-8"
                  ></span>
                  <select
                    name="sort_by"
                    class="select py-0 pl-8 h-9 text-sm/5 text-[var(--text--sub-600)] rounded-[var(--radius-8)]"
                  >
                    <option value="name" {% if selected_sort == 'name' %}selected{% endif %}>Name (A-Z)</option>
                    <option value="-name" {% if selected_sort == '-name' %}selected{% endif %}>Name (Z-A)</option>
                    <option value="-created_at" {% if selected_sort == '-created_at' %}selected{% endif %}>Newest First</option>
                    <option value="created_at" {% if selected_sort == 'created_at' %}selected{% endif %}>Oldest First</option>
                  </select>
                </label>
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-outline btn-block">Search</button>
        </form>

        {% include "pages/home/partials/templates_list.html" %}

      </div>
    </section>


    <dialog id="template_detail_modal" class="modal modal-bottom sm:modal-end">
      <div class="modal-box p-0 !h-[97vh] my-auto mr-3.5 !w-[95vw] !max-w-[57rem] rounded-[1.25rem] overflow-y-auto flex flex-col justify-between">
        <div class="flex justify-between p-5 w-full">
          <h3 id="modal-template-name" class="text-lg/6 font-medium">Loading...</h3>
          <div class="flex items-center">
            <button id="modal-delete-btn" type="button" class="flex items-center mr-3" style="display:none;" onclick="deleteTemplateFromDialog()">
              <span data-icon="delete-bin-5-line" data-size="20" data-color="var(--icon--sub-600)"></span>
              <span class="var(--text--sub-600) ml-1 underline">Delete</span>
            </button>
            <button type="button" onclick="template_detail_modal.close()" class="btn btn-sm btn-circle btn-ghost">
              <span data-icon="close-line" data-size="16" data-color="var(--icon--sub-600)"></span>
            </button>
          </div>
        </div>
        <form id="template-form" class="flex-1 overflow-y-auto hide-scrollbar">
          {% csrf_token %}
          <input type="hidden" id="template-id" name="template_id" />
          <input type="hidden" id="can-edit" value="false" />
          <div class="px-5 py-4 grid grid-cols-3 gap-4">
            <fieldset class="fieldset col-span-3">
              <legend class="fieldset-legend">Title<span class="text-[var(--state--error--base)]">*</span></legend>
              <label class="input validator w-full">
                <input id="template-name" name="name" type="text" required minlength="2" maxlength="200" />
              </label>
              <p class="validator-hint">Required (2-200 characters)</p>
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Country<span class="text-[var(--state--error--base)]">*</span></legend>
              <select id="template-country" name="country_id" class="select" required>
                <option value="">Select country</option>
                {% for country in countries %}
                  <option value="{{ country.id }}">{{ country.name }}</option>
                {% endfor %}
              </select>
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Building component</legend>
              <select id="template-category" name="category_id" class="select" disabled>
                <option value="">Select category</option>
                {% for category in categories %}
                  <option value="{{ category.id }}">{{ category.name }}</option>
                {% endfor %}
              </select>
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Construction technique</legend>
              <select id="template-technique" name="technique_id" class="select" disabled>
                <option value="">Select technique</option>
                {% for technique in techniques %}
                  <option value="{{ technique.id }}">{{ technique.name }}</option>
                {% endfor %}
              </select>
            </fieldset>
            <fieldset class="fieldset col-span-3">
              <legend class="fieldset-legend">Comment</legend>
              <textarea id="template-comment" name="comment" class="textarea w-full" rows="3" placeholder="Add a comment"></textarea>
            </fieldset>
          </div>
          <h2 class="bg-[var(--bg--weak-50)] w-full px-5 py-1.5 text-[var(--text--sub-600)] text-xs/4 font-medium mb-4">
            MATERIALS (<span id="modal-materials-count">0</span>)
          </h2>
          <div class="px-5 pb-4">
            <div class="flex items-end justify-between border-b border-[var(--stroke--soft-200)] pb-4">
              <div class="flex-1">
                <h4 class="text-base/5 font-extrabold mb-1">Added Materials</h4>
                <p class="text-sm/5 text-[var(--text--sub-600)]">Materials from EPD libraries</p>
              </div>
              <button type="button" class="btn btn-sm btn-outline" onclick="alert('EPD modal integration - Coming soon')">
                <span data-icon="add-large-fill" data-size="20" data-color="var(--icon--strong-950)"></span>
                Add from EPD library
              </button>
            </div>
            <ul id="modal-materials-list" class="grid grid-cols-1 gap-2.5 mt-4">
              <li class="bg-[var(--bg--weak-50)] rounded-xl p-4">
                <div class="flex items-center justify-between mb-2 w-full">
                  <span class="text-sm/5 font-medium"
                    >Ready-Mix Concrete C25/30</span
                  >
                  <a>
                    <span
                      data-icon="external-link-line"
                      data-size="20"
                      data-color="var(--icon--sub-600)"
                    ></span>
                  </a>
                </div>
                <div
                  class="flex items-stretch gap-1 bg-[var(--bg--white-0)] rounded-xl p-2.5"
                >
                  <div
                    class="bg-[var(--bg--weak-50)] px-1 flex items-center shrink-0 rounded-[var(--radius-6)]"
                  >
                    <span data-country="KH" data-width="20"></span>
                  </div>
                  <label class="input flex-[2.5]">
                    <input type="text" placeholder="Add description" />
                  </label>
                  <label class="input flex-1">
                    <input type="number" value="1" />
                    <span class="text-xs/5 text-[var(--text--sub-600)]">%</span>
                  </label>
                  <div class="flex items-center py-2 mr-1.5">
                    <div
                      class="w-[0.0625rem] bg-[var(--stroke--soft-200)] h-full"
                    ></div>
                  </div>
                  <button
                    class="btn px-1.5 btn-outline border-[var(--stroke--soft-200)] self-stretch aspect-square shrink-0"
                  >
                    <span
                      data-icon="delete-bin-5-line"
                      data-size="20"
                      data-color="var(--icon--strong-950)"
                    ></span>
                  </button>
                </div>
              </li>
              <li class="bg-[var(--bg--weak-50)] rounded-xl p-4">
                <div class="flex items-center justify-between mb-2 w-full">
                  <span class="text-sm/5 font-medium">Sand-lime brick</span>
                  <a>
                    <span
                      data-icon="external-link-line"
                      data-size="20"
                      data-color="var(--icon--sub-600)"
                    ></span>
                  </a>
                </div>
                <div
                  class="flex items-stretch gap-1 bg-[var(--bg--white-0)] rounded-xl p-2.5"
                >
                  <div
                    class="bg-[var(--bg--weak-50)] px-1 flex items-center shrink-0 rounded-[var(--radius-6)]"
                  >
                    <span data-country="KH" data-width="20"></span>
                  </div>
                  <label class="input flex-[2.5]">
                    <input type="text" placeholder="Add description" />
                  </label>
                  <label class="input flex-1">
                    <input type="number" value="1" />
                    <span class="text-xs/5 text-[var(--text--sub-600)]">%</span>
                  </label>
                  <div class="flex items-center py-2 mr-1.5">
                    <div
                      class="w-[0.0625rem] bg-[var(--stroke--soft-200)] h-full"
                    ></div>
                  </div>
                  <button
                    class="btn px-1.5 btn-outline border-[var(--stroke--soft-200)] self-stretch aspect-square shrink-0"
                  >
                    <span
                      data-icon="delete-bin-5-line"
                      data-size="20"
                      data-color="var(--icon--strong-950)"
                    ></span>
                  </button>
                </div>
              </li>
              <li class="bg-[var(--bg--weak-50)] rounded-xl p-4">
                <div class="flex items-center justify-between mb-2 w-full">
                  <span class="text-sm/5 font-medium"
                    >Ready-Mix Concrete C25/30</span
                  >
                  <a>
                    <span
                      data-icon="external-link-line"
                      data-size="20"
                      data-color="var(--icon--sub-600)"
                    ></span>
                  </a>
                </div>
                <div
                  class="flex items-stretch gap-1 bg-[var(--bg--white-0)] rounded-xl p-2.5"
                >
                  <div
                    class="bg-[var(--bg--weak-50)] px-1 flex items-center shrink-0 rounded-[var(--radius-6)]"
                  >
                    <span data-country="DE" data-width="20"></span>
                  </div>
                  <label class="input flex-[5]">
                    <input type="text" placeholder="Add description" />
                  </label>
                  <label class="input flex-1">
                    <input type="number" placeholder="eg.150" />
                    <span class="text-xs/5 text-[var(--text--sub-600)]"
                      >pcs</span
                    >
                  </label>
                  <div class="flex items-center py-2 mr-1.5">
                    <div
                      class="w-[0.0625rem] bg-[var(--stroke--soft-200)] h-full"
                    ></div>
                  </div>
                  <button
                    class="btn px-1.5 btn-outline border-[var(--stroke--soft-200)] self-stretch aspect-square shrink-0"
                  >
                    <span
                      data-icon="delete-bin-5-line"
                      data-size="20"
                      data-color="var(--icon--strong-950)"
                    ></span>
                  </button>
                </div>
              </li>
            </ul>
          </div>
          <div class="p-5 w-full border-t border-[var(--stroke--soft-200)] flex items-center justify-between">
            <button type="button" class="btn btn-outline text-[var(--text--sub-600)] border-[var(--stroke--soft-200)] w-fit" onclick="template_detail_modal.close()">
              Cancel
            </button>
            <div class="flex items-center gap-2">
              <button type="button" id="modal-duplicate-btn" class="btn btn-outline text-[var(--text--strong-950)] border-[var(--stroke--strong-950)] w-fit" onclick="handleDuplicate()">
                Save & duplicate
              </button>
              <button type="button" id="modal-update-btn" class="btn btn-primary w-fit" style="display:none;" onclick="handleUpdate()">
                Update
              </button>
            </div>
          </div>
        </form>
      </div>
    </dialog>

    <dialog
      id="structural_component_epd_modal"
      class="modal modal-bottom sm:modal-end"
    >
      <div
        class="modal-box p-0 !h-[97vh] my-auto mr-3.5 !w-full !max-w-[57rem] rounded-[1.25rem] overflow-y-auto flex flex-col justify-between"
      >
        <div class="flex justify-between items-center px-5 w-full">
          <button
            type="button"
            onclick="structural_component_epd_modal.close()"
            class="btn btn-sm btn-outline"
          >
            <span
              data-icon="arrow-left"
              data-size="16"
              data-color="var(--icon--soft-400)"
            ></span>
            Go back
          </button>
          <h3 class="text-lg/6 font-medium w-full text-left p-5">
            Add from EPD Library
          </h3>
          <button
            type="button"
            onclick="structural_component_epd_modal.close()"
            class="btn btn-sm btn-circle btn-ghost"
          >
            <span
              data-icon="close-line"
              data-size="16"
              data-color="var(--icon--sub-600)"
            ></span>
          </button>
        </div>
        <form method="dialog" class="flex-1 overflow-y-auto hide-scrollbar">
          <div class="px-5 py-2.5 w-full">
            <div
              class="p-2.5 flex flex-col w-full rounded-[var(--radius-10)] bg-[var(--bg--weak-50)]"
            >
              <div class="flex items-stretch gap-2">
                <label class="input w-full">
                  <span
                    data-icon="search-2-line"
                    data-size="16"
                    data-color="var(--icon--soft-400)"
                  ></span>
                  <input type="text" placeholder="Search..." />
                </label>
                <select class="select">
                  <option selected value="usa">
                    <span data-country="US" data-width="20"></span>
                    <span data-country="US" data-flag="false"></span>
                  </option>
                  <option value="canada">
                    <span data-country="CA" data-width="20"></span>
                    <span data-country="CA" data-flag="false"></span>
                  </option>
                  <option value="uk">
                    <span data-country="GB" data-width="20"></span>
                    <span data-country="GB" data-flag="false"></span>
                  </option>
                  <option value="australia">
                    <span data-country="AU" data-width="20"></span>
                    <span data-country="AU" data-flag="false"></span>
                  </option>
                </select>
              </div>
              <div class="collapse rounded-none">
                <input type="checkbox" class="peer" />
                <div
                  class="group collapse-title p-2.5 px-0 bg-[var(--bg--weak-50)] text-[0.813rem]/5 font-semibold flex items-center justify-between rounded-[var(--radius-4)]"
                >
                  <span class="flex items-center gap-2">
                    <span
                      data-icon="menu-search-line"
                      data-size="20"
                      data-color="var(--icon--strong-950)"
                    ></span>
                    Advanced Search
                    <span class="text-xs/5 text-[var(--text--sub-600)]"
                      >Click here for a more advanced search option</span
                    >
                  </span>
                  <span
                    data-icon="caret-down"
                    data-size="16"
                    data-color="var(--icon--soft-400)"
                    class="transition-transform duration-300 ease-in-out group-[peer:checked]:rotate-180"
                  ></span>
                </div>
                <div class="collapse-content mt-0 px-0">
                  <div class="grid grid-cols-4 gap-2">
                    <label class="relative">
                      <span
                        data-icon="filter-3-line"
                        data-size="20"
                        data-color="var(--icon--soft-400)"
                        class="select-icon w-8"
                      ></span>
                      <select
                        class="select py-0 pl-8 h-9 text-sm/5 text-[var(--text--sub-600)] rounded-[var(--radius-8)]"
                      >
                        <option disabled selected value="">Category</option>
                        <option value="building-service-engineering">
                          Building service engineering
                        </option>
                        <option value="components-for-windows">
                          Components for windows & curtain walls
                        </option>
                        <option value="composites">Composites</option>
                        <option value="end-of-life">End of life</option>
                        <option value="insulation-materials">
                          Insulation materials
                        </option>
                        <option value="metals">Metals</option>
                        <option value="minerals-building-products">
                          Minerals building products
                        </option>
                        <option value="plastics">Plastics</option>
                        <option value="wood">Wood</option>
                        <option value="others">Others</option>
                        <option value="unkwown">Unkwown</option>
                      </select>
                    </label>
                    <label class="relative">
                      <span
                        data-icon="filter-3-line"
                        data-size="20"
                        data-color="var(--icon--soft-400)"
                        class="select-icon w-8"
                      ></span>
                      <select
                        class="select py-0 pl-8 h-9 text-sm/5 text-[var(--text--sub-600)] rounded-[var(--radius-8)]"
                      >
                        <option disabled selected value="">Sub-category</option>
                        <option value="air-conditioning-and-ventilation">
                          Air conditioning and ventilation
                        </option>
                        <option value="conveyance">Conveyance</option>
                        <option value="electrical">Electrical</option>
                        <option value="end-of-life-processes">
                          End of life processes
                        </option>
                        <option value="fire-protection">Fire protection</option>
                        <option value="heating">Heating</option>
                        <option value="sanitary">Sanitary</option>
                        <option value="use">Use</option>
                      </select>
                    </label>
                    <label class="relative">
                      <span
                        data-icon="filter-3-line"
                        data-size="20"
                        data-color="var(--icon--soft-400)"
                        class="select-icon w-8"
                      ></span>
                      <select
                        class="select py-0 pl-8 h-9 text-sm/5 text-[var(--text--sub-600)] rounded-[var(--radius-8)]"
                      >
                        <option disabled selected value="">
                          Child-category
                        </option>
                        <option value="use-conveyor">Use conveyor</option>
                        <option value="use-heat-generator">
                          Use heat generator
                        </option>
                        <option value="use-heat-generator-enev">
                          Use heat generator (EnEv)
                        </option>
                        <option value="using-lighting">Using lighting</option>
                        <option value="using-mountings">Using mountings</option>
                        <option value="use-ventilations-and-air-conditioning">
                          Use ventilations and air conditioning
                        </option>
                      </select>
                    </label>
                    <label class="relative">
                      <span
                        data-icon="filter-3-line"
                        data-size="20"
                        data-color="var(--icon--soft-400)"
                        class="select-icon w-8"
                      ></span>
                      <select
                        class="select py-0 pl-8 h-9 text-sm/5 text-[var(--text--sub-600)] rounded-[var(--radius-8)]"
                      >
                        <option disabled selected value="">EPD type</option>
                        <option value="official">Official</option>
                        <option value="custom">Custom</option>
                        <option value="generic">Generic</option>
                      </select>
                    </label>
                    <label class="relative">
                      <span
                        data-icon="filter-3-line"
                        data-size="20"
                        data-color="var(--icon--soft-400)"
                        class="select-icon w-8"
                      ></span>
                      <select
                        class="select py-0 pl-8 h-9 text-sm/5 text-[var(--text--sub-600)] rounded-[var(--radius-8)]"
                      >
                        <option disabled selected value="">Sort by</option>
                      </select>
                    </label>
                  </div>
                </div>
              </div>
              <button class="btn btn-outline btn-block" disabled>Search</button>
            </div>
            <ul class="grid grid-cols-1">
              <li
                class="py-2.5 flex items-center justify-between gap-2.5 not-last:border-b border-[var(--stroke--soft-200)]"
              >
                <div class="flex flex-col gap-2.5">
                  <div class="flex items-center justify-between">
                    <span
                      >Structural concrete M6582A09 (C30/37, F4, 16, XC4, XF1,
                      XA1, XD1, WA, slow)</span
                    >
                  </div>
                  <div class="flex items-stretch gap-1.25">
                    <span
                      class="badge gap-1 py-1 px-2 bg-[var(--bg--weak-50)] text-[var(--text--sub-600)]"
                      >Germany</span
                    >
                    <div
                      class="bg-[var(--stroke--sub-300)] w-[0.0625rem] my-1"
                    ></div>
                    <span
                      class="badge badge-outline py-1 px-2 border-[var(--stroke--soft-200)] text-[var(--text--sub-600)]"
                      >Precast concrete elements and goods</span
                    >
                    <span
                      class="badge badge-outline py-1 px-2 border-[var(--stroke--soft-200)] text-[var(--text--sub-600)]"
                      >169.40 kgCO2e</span
                    >
                  </div>
                </div>
                <div class="flex flex-col items-end gap-2.5 w-fit">
                  <span
                    data-icon="external-link-line"
                    data-size="20"
                    data-color="var(--icon--sub-600)"
                  ></span>
                  <button
                    class="btn btn-sm btn-outline w-fit border-[var(--stroke--soft-200)] rounded-[var(--radius-8)]"
                    type="button"
                  >
                    <span
                      data-icon="add-large-fill"
