{
  "name": "beat-tool-qa",
  "main": "cf-worker/index.mjs",
  "compatibility_date": "2026-06-01",
  "containers": [
    {
      "class_name": "BeatQaContainer",
      "image": "./Dockerfile.cloudflare",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BEAT_QA_CONTAINER",
        "class_name": "BeatQaContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BeatQaContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
